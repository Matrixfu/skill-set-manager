{
  "name": "@matrixfu/skill-set-manager",
  "version": "1.3.2",
  "type": "module",
  "description": "技能集管理器：按项目绑定的技能集与生效清单（junction 生成、常驻并集、临时覆盖、自检红标）",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Matrixfu/skill-set-manager.git"
  },
  "homepage": "https://github.com/Matrixfu/skill-set-manager#readme",
  "bugs": {
    "url": "https://github.com/Matrixfu/skill-set-manager/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "agent-skills",
    "skills",
    "skill-manager"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/**/*",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "zod": "4.6.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots",
        "locale"
      ]
    }
  }
}
